# ----- Supabase (required) -----
# Create these on Netlify: Site settings → Environment variables
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# ----- Marketing / Analytics (optional but recommended) -----
# Meta Pixel ID from Events Manager (https://business.facebook.com/events_manager2).
# Leave blank to disable Meta tracking.
VITE_META_PIXEL_ID=""

# Google Analytics 4 Measurement ID, e.g. "G-XXXXXXXXXX"
# Leave blank to disable GA4 tracking.
VITE_GA4_ID=""
